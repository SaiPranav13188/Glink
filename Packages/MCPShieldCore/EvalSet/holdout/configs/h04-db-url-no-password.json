{
  "mcpServers": {
    "postgres-local": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-postgres@0.6.2", "postgresql://localhost:5432/dev"]
    },
    "postgres-user-only": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-postgres@0.6.2"],
      "env": { "DATABASE_URL": "postgres://readonly@db.internal:5432/analytics" }
    }
  }
}
